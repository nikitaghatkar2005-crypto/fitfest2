# ==================== REQUIRED ====================

# Neon PostgreSQL connection string (pooled recommended for serverless)
# Get it from: https://console.neon.tech → Project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Strong random secret for session/JWT (min 32 characters)
# Generate one at: https://generate-secret.vercel.app/32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ==================== EMAIL (Resend) ====================

# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender (domain must be verified in Resend)
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="Fitfest 2026"

# ==================== OPTIONAL ====================

# Vercel Blob (for image uploads). Create a store in Vercel Dashboard → Storage
BLOB_READ_WRITE_TOKEN=""

# Unpooled connection (sometimes needed for migrations)
# DATABASE_URL_UNPOOLED=""
